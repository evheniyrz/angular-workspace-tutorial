{
  "name": "angular-workspace-tutorial",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:ppublic": "ng serve -o --project public-pages --port 4201",
    "start:profile": "ng serve -o --project profile --port 4202",
    "start:catalog": "ng serve -o --project catalog --port 4203",
    "build:ppublic": "ng build public-pages && cp -a dist/public-pages/. ../../nginx-1.25.3/html/public-pages/",
    "build:profile": "ng build profile && cp -a dist/profile/. ../../nginx-1.25.3/html/profile/",
    "build:catalog": "ng build catalog && cp -a dist/catalog/. ../../nginx-1.25.3/html/catalog/",
    "build:all": "yarn build:ppublic && build:profile && build:catalog",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:public-pages": "node dist/public-pages/server/server.mjs",
    "serve:ssr:profile": "node dist/profile/server/server.mjs",
    "serve:ssr:catalog": "node dist/catalog/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.1.6",
    "@angular/cdk": "~19.1.4",
    "@angular/common": "^19.1.6",
    "@angular/compiler": "^19.1.6",
    "@angular/core": "^19.1.6",
    "@angular/forms": "^19.1.6",
    "@angular/material": "~19.1.4",
    "@angular/platform-browser": "^19.1.6",
    "@angular/platform-browser-dynamic": "^19.1.6",
    "@angular/platform-server": "^19.1.6",
    "@angular/router": "^19.1.6",
    "@angular/ssr": "^19.1.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "mongodb": "^6.8.0",
    "rxjs": "~7.8.0",
    "swiper": "^11.1.8",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.1.7",
    "@angular/cli": "^19.1.7",
    "@angular/compiler-cli": "^19.1.6",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.1.2",
    "typescript": "~5.7.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
